/dts-v1/;

#include <dt-bindings/leds/common.h>
#include "gs101-pixel-common.dtsi"

/ {
	model = "Raven";
	compatible = "google,gs101-raven", "google,gs101";

	/*
	 * ABL picks the base DTB by soc_id (product id 0x09845000 | major
	 * revision); the factory vendor_boot carries one per revision. B0 = 1.
	 */
	soc_id = <0x09845001 0x0>;

	chosen {
		/*
		 * ABL appends its own arguments (console=null among them), so a
		 * panic is silent: panic=10 reboots instead of hanging. init hands
		 * over to the Arch root on userdata when it finds one.
		 * mem_sleep_default=s2idle: the firmware offers PSCI system
		 * suspend, so "mem" would otherwise mean "deep", which needs a
		 * PMU sleep sequence the kernel doesn't have yet.
		 */
		bootargs = "console=tty0 panic=10 clk_ignore_unused rdinit=/init mem_sleep_default=s2idle";
	};

	reserved-memory {
		/*
		 * Scanout buffers for gs-decon: DPP0 takes 32-bit addresses and
		 * the DPU SysMMU is bypassed (as on cheetah). Five 1440x3120
		 * XRGB8888 buffers; reusable while unused.
		 */
		display_pool: display-pool {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x5c00000>;
			alignment = <0x0 0x200000>;
			/* Not in 3.75-4 GiB: DPP0's reads from 0xf2c00000+ hung silently */
			alloc-ranges = <0x0 0xa0000000 0x40000000>;
		};
	};
};

&acpm_ipc {
	/*
	 * ABL leaves the memory bus at 2028 MHz and nothing scales it yet.
	 * 1014 MHz saved about 70 mA, as much as stock's
	 * 421 MHz idle, with headroom for the display and the GPU.
	 */
	assigned-clocks = <&acpm_ipc GS101_CLK_ACPM_DVFS_MIF>;
	assigned-clock-rates = <1014000000>;

	pmic-2 {
		regulators {
			ldo4s {
				regulator-name = "vdd2_uwb";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3300000>;
			};

			ldo14s {
				regulator-name = "vdd3_uwb";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};
		};
	};
};

/* Unused blocks the bootloader leaves powered: genpd turns them off */
&pd_aoc {
	status = "okay";
};

&pd_g2d {
	status = "okay";
};

&pd_mfc {
	status = "okay";
};

&pd_csis {
	status = "okay";
};

&pd_pdp {
	status = "okay";
};

&pd_dns {
	status = "okay";
};

&pd_g3aa {
	status = "okay";
};

&pd_ipp {
	status = "okay";
};

&pd_itp {
	status = "okay";
};

&pd_mcsc {
	status = "okay";
};

&pd_gdc {
	status = "okay";
};

&pd_tnr {
	status = "okay";
};

&pd_bo {
	status = "okay";
};

&pd_tpu {
	status = "okay";
};

/* Bluetooth: the BCM4389 on the APM USI1 UART (Google's gs101-common-bluetooth) */
&usi_apm1 {
	status = "okay";
};

&serial_apm1 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4389-bt";
		shutdown-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpp14 3 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpa6 6 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wakeup";
		max-speed = <3000000>;
	};
};

&acpm_tmu {
	status = "okay";
};

/* AoC bring-up: Trusty and the GSA mailbox */
&trusty {
	status = "okay";
};

&gsa {
	status = "okay";
};

/*
 * The AoC's sensor rails, as on stock raven: the AoC driver power-cycles
 * and enables them at probe. The microphones are on ldo20m, always on.
 */
&aoc {
	google,board-id = <0x20202>;
	google,board-rev = <0x10000>;
	/* D_TZPC_AOC: stock pd_aoc's need_smc, restored by an EL3 SMC */
	google,tzpc-smc = <0x1a010204>;
	sensor_1v8-supply = <&{/firmware/power-management/pmic-2/regulators/ldo7s}>;
	sensor_3v3-supply = <&{/firmware/power-management/pmic-2/regulators/ldo6s}>;
	sensor_power_list = "sensor_1v8", "sensor_3v3";
};

&cont_splash_mem {
	reg = <0x0 0xfac00000 (1440 * 3120 * 4)>;

	status = "okay";
};

/* The display: gs-decon takes over the bootloader's pipeline from simpledrm */
&decon0 {
	memory-region = <&display_pool>, <&cont_splash_mem>;
	memory-region-names = "pool", "boot-framebuffer";
	status = "okay";
};

&dsi0 {
	/* mask DECON's trigger while the panel's display is off */
	google,decon = <&decon0>;
	status = "okay";

	/* brightness, display on/off and 60/120 Hz; the bootloader runs it */
	panel@0 {
		compatible = "samsung,s6e3hc3";
		reg = <0>;
	};
};

&framebuffer0 {
	width = <1440>;
	height = <3120>;
	stride = <(1440 * 4)>;
	format = "a8r8g8b8";

	status = "okay";
};

/*
 * Touch: a Samsung S6SY79x on SPI 11 (Google's gs101-sec-touch.dtsi and
 * gs101-common-touch.dtsi): 10 MHz, mode 3, interrupt on gpa9-0, an
 * active-low reset on gpp26-0 (sec_ts drives it 0 until powered, then
 * 1, 0, 1), DVDD on LDO25M and AVDD on LDO26M, which
 * gs101-raven-touch.dtsi pins to 1.8 V and 3.3 V.
 */
&usi11 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_11 {
	cs-gpios = <&gpp23 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	pinctrl-0 = <&spi11_bus &spi11_cs>;
	status = "okay";

	touchscreen@0 {
		compatible = "samsung,s6sy79x";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-cpol;
		spi-cpha;
		interrupt-parent = <&gpa9>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp26 0 GPIO_ACTIVE_LOW>;
		vdd-supply = <&{/firmware/power-management/pmic-1/regulators/ldo25m}>;
		avdd-supply = <&{/firmware/power-management/pmic-1/regulators/ldo26m}>;
		touchscreen-size-x = <1440>;
		touchscreen-size-y = <3120>;
	};
};

/* TS_SPI_SEL: low gives the touch controller's bus to the AP, not the AoC */
&gpp26 {
	ts-spi-sel-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "ts-spi-sel";
	};
};

&{/firmware/power-management/pmic-1/regulators/ldo25m} {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&{/firmware/power-management/pmic-1/regulators/ldo26m} {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

/*
 * GNSS: Broadcom BCM4775x on PERIC0 USI5 SPI (Google's spi5), 26 MHz, mode 3,
 * as stock's raven device tree describes it (bcm4775@0). The chip select is
 * driven as a GPIO, as on cheetah. Its supplies are S2MPG11 LDO9S-LDO11S
 * (stock: L9S_GNSS_CORE, L10S_GNSS_RF, L11S_GNSS_AUX). The stock lhd/gpsd
 * daemons drive it through /dev/ttyBCM. Disabled until the gnss-test
 * overlay.
 */
&usi5 {
	samsung,mode = <USI_MODE_SPI>;
};

&spi_5 {
	pinctrl-0 = <&spi5_bus &gnss_spi_cs>;
	cs-gpios = <&gpp10 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;

	gnss@0 {
		compatible = "brcm,bcm4775-gnss";
		reg = <0>;
		spi-max-frequency = <26000000>;
		spi-cpol;
		spi-cpha;
		interrupts-extended = <&gpa6 4 IRQ_TYPE_LEVEL_HIGH>;
		/* Raw levels: lhd writes 1 to the nstandby attribute to run it */
		nstandby-gpios = <&gpp0 2 GPIO_ACTIVE_HIGH>;
		mcu-req-gpios = <&gpp1 1 GPIO_ACTIVE_HIGH>;
		mcu-resp-gpios = <&gpp0 0 GPIO_ACTIVE_HIGH>;
		host-req-gpios = <&gpa6 4 GPIO_ACTIVE_HIGH>;
		vddcore-supply = <&{/firmware/power-management/pmic-2/regulators/ldo9s}>;
		vddrf-supply = <&{/firmware/power-management/pmic-2/regulators/ldo10s}>;
		vddaux-supply = <&{/firmware/power-management/pmic-2/regulators/ldo11s}>;
		pinctrl-0 = <&gnss_nstandby &gnss_mcu_resp &gnss_mcu_req
			     &gnss_host_req>;
		pinctrl-names = "default";
	};
};

&pinctrl_far_alive {
	gnss_host_req: gnss-host-req-pins {
		samsung,pins = "gpa6-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	gnss_mcu_resp: gnss-mcu-resp-pins {
		samsung,pins = "gpp0-0";
		samsung,pin-function = <GS101_PIN_FUNC_INPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
	};

	gnss_nstandby: gnss-nstandby-pins {
		samsung,pins = "gpp0-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	gnss_mcu_req: gnss-mcu-req-pins {
		samsung,pins = "gpp1-1";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	gnss_spi_cs: gnss-spi-cs-pins {
		samsung,pins = "gpp10-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

/*
 * Rear flash LED: TI LM3644 at 0x63 on PERIC0 USI7 (Google's I2C bus 7, also
 * the cameras' bus), HWEN on gpp23-6, as stock's raven device tree
 * describes it. Stock drives it from the camera HAL through LWIS; torch only
 * here, with cheetah's bring-up cap (not a stock value).
 */
&usi7 {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_7 {
	clock-frequency = <370000>;
	status = "okay";

	led-controller@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;
		enable-gpios = <&gpp23 6 GPIO_ACTIVE_HIGH>;

		led {
			function = LED_FUNCTION_TORCH;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <1 2>;
			led-max-microamp = <50000>;
		};
	};

	/*
	 * The camera PMIC. Its boost, buck and pull-up lines (S2MPG11 GPIOs
	 * 1, 3 and 4) have no binding yet; they must be high before chip
	 * select, in that order. The LDOs carry no voltage constraints, so
	 * nothing sets a voltage until the camera supplies are described.
	 */
	pmic@75 {
		compatible = "dlg,slg51000";
		reg = <0x75>;
		dlg,cs-gpios = <&s2mpg11_gpio 0 GPIO_ACTIVE_HIGH>;
		status = "disabled";

		regulators {
			cam_ldo1: ldo1 {
				regulator-name = "cam_ldo1";
				/* stock waits 3 ms before the next camera supply */
				regulator-enable-ramp-delay = <3000>;
			};

			cam_ldo2: ldo2 {
				regulator-name = "cam_ldo2";
			};

			cam_ldo3: ldo3 {
				regulator-name = "cam_ldo3";
			};

			cam_ldo4: ldo4 {
				regulator-name = "cam_ldo4";
			};

			cam_ldo5: ldo5 {
				regulator-name = "cam_ldo5";
			};

			cam_ldo6: ldo6 {
				regulator-name = "cam_ldo6";
			};

			cam_ldo7: ldo7 {
				regulator-name = "cam_ldo7";
			};
		};
	};
};

/*
 * The ultrawide camera's bus (Google's I2C bus 3): the IMX386 at 0x1a and
 * its module EEPROM at 0x50, both powered from the camera PMIC, so the bus
 * stays disabled until the camera supplies are described. Stock pulls the
 * lines up in the SoC while the bus is in use and runs it at 950 kHz;
 * fast mode is plenty for bring-up.
 */
&hsi2c3_bus {
	samsung,pin-pud = <GS101_PIN_PULL_UP>;
};

&usi3 {
	samsung,mode = <USI_MODE_I2C>;
};

&hsi2c_3 {
	clock-frequency = <400000>;

	/*
	 * The ultrawide, a Sony IMX386. Stock's power-up: LDO1, 3 ms (the
	 * ramp delay above), LDO4, 1 ms, MCLK, 1 ms, reset released, 10 ms.
	 * The board feeds the module only LDO1 (3.05 V) and LDO4 (2.9 V), so
	 * the module makes its interface and core supplies from LDO1. The
	 * MCLK runs from the 24.576 MHz oscillator, which is what stock's
	 * sensor settings declare (EXCK_FREQ 0x1893). Not connected to a
	 * receiver yet: the endpoint has no remote.
	 */
	camera-sensor@1a {
		compatible = "sony,imx386";
		reg = <0x1a>;
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
		assigned-clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK0>;
		assigned-clock-rates = <24576000>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_uw_mclk_on>;
		reset-gpios = <&gpp6 3 GPIO_ACTIVE_LOW>;
		vif-supply = <&cam_ldo1>;
		vdig-supply = <&cam_ldo1>;
		vana-supply = <&cam_ldo4>;
		firmware-name = "omamobile/camera/imx386-uw.bin";
		orientation = <1>;	/* back */
		/* as cheetah's ultrawide: upright in portrait at 270 */
		rotation = <270>;
		status = "disabled";

		port {
			/* the rate is stock's; four lanes as on cheetah [I] */
			endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <774144000>;
			};
		};
	};
};

&pinctrl_peric0 {
	cam_uw_mclk_on: cam-uw-mclk-on-pins {
		samsung,pins = "gpp3-0";
		samsung,pin-function = <GS101_PIN_FUNC_2>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_5_MA>;
	};
};

/ {
	/* the amplifiers' VP comes straight from the battery (V_SYS) */
	amp_vp: regulator-amp-vp {
		compatible = "regulator-fixed";
		regulator-name = "amp-vp";
		regulator-min-microvolt = <4200000>;
		regulator-max-microvolt = <4200000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

/*
 * The speaker amplifiers: two CS35L41 on SPI 13 (USI13), as in stock's raven
 * device tree. Chip select 0 is the top speaker (earpiece), 1 the bottom
 * loudspeaker. Their audio comes from the AoC's TDM 0 port; the nodes stay
 * disabled until a sound card describes that link.
 */
&usi13 {
	samsung,mode = <USI_MODE_SPI>;
};

&spi_13 {
	pinctrl-0 = <&spi13_bus &amp_miso &amp_top_cs &amp_bottom_cs>;
	cs-gpios = <&gpp25 3 GPIO_ACTIVE_LOW>, <&gpp1 0 GPIO_ACTIVE_LOW>;
	num-cs = <2>;

	amp_top: amplifier@0 {
		compatible = "cirrus,cs35l41";
		reg = <0>;
		#sound-dai-cells = <1>;
		spi-max-frequency = <25000000>;
		interrupts-extended = <&gpa6 3 IRQ_TYPE_LEVEL_HIGH>;
		reset-gpios = <&gpp16 3 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&amp_top_irq &amp_top_rst>;
		pinctrl-names = "default";
		VA-supply = <&s2mpg11_bucka>;
		VP-supply = <&amp_vp>;
		sound-name-prefix = "Top";
		cirrus,subsystem-id = "raven";
		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <3500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		/* the stock protection firmware does not survive hibernation */
		cirrus,dsp-no-hibernate;
		/* GPIO2 = push-pull interrupt, active high */
		cirrus,gpio2-src-select = <5>;
		cirrus,gpio2-output-enable;
		status = "disabled";
	};

	amp_bottom: amplifier@1 {
		compatible = "cirrus,cs35l41";
		reg = <1>;
		#sound-dai-cells = <1>;
		spi-max-frequency = <25000000>;
		interrupts-extended = <&gpa9 6 IRQ_TYPE_LEVEL_HIGH>;
		reset-gpios = <&gpp23 7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&amp_bottom_irq &amp_bottom_rst>;
		pinctrl-names = "default";
		VA-supply = <&s2mpg11_bucka>;
		VP-supply = <&amp_vp>;
		sound-name-prefix = "Bottom";
		cirrus,subsystem-id = "raven";
		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <3500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		cirrus,dsp-no-hibernate;
		cirrus,gpio2-src-select = <5>;
		cirrus,gpio2-output-enable;
		status = "disabled";
	};
};

&pinctrl_far_alive {
	amp_top_irq: amp-top-irq-pins {
		samsung,pins = "gpa6-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_gpio_alive {
	amp_bottom_irq: amp-bottom-irq-pins {
		samsung,pins = "gpa9-6";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	amp_bottom_cs: amp-bottom-cs-pins {
		samsung,pins = "gpp1-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	amp_top_rst: amp-top-rst-pins {
		samsung,pins = "gpp16-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric1 {
	amp_top_cs: amp-top-cs-pins {
		samsung,pins = "gpp25-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	/* stock pulls MISO down while no chip drives it */
	amp_miso: amp-miso-pins {
		samsung,pins = "gpp25-2";
		samsung,pin-function = <GS101_PIN_FUNC_2>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
	};

	amp_bottom_rst: amp-bottom-rst-pins {
		samsung,pins = "gpp23-7";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

/*
 * The panel's rails (the framebuffer's vci and vddi supplies). simpledrm
 * holds them; when gs-decon takes the display over, simpledrm goes away and
 * releases them, the panel lost power and DECON stalled on its first flip.
 * Keep them on until the panel driver owns them.
 */
&s2mpg10_ldo22m {
	regulator-always-on;
};

&s2mpg11_bucka {
	regulator-always-on;
};

/* The Mali-G78 MP20 on its S2MPG10/11 rails, as postmarketOS describes them */
&gpu {
	mali-supply = <&s2mpg11_buck2s>;
	g3d-l2-supply = <&s2mpg11_buck8s>;
	g3d-m-supply = <&s2mpg11_ldo1s>;
	int-m-supply = <&s2mpg10_buck7m>;

	status = "okay";
};

/*
 * The CPU zones report the cluster hotspot through ACPM, which can jump by
 * 30 °C for one sample under a short burst of load. Google's raven
 * throttles from 90 °C and only has a "hot" trip at 115 °C: keep our
 * throttling from 75 °C and power off at a sustained 115 °C.
 */
&big_crit {
	temperature = <115000>;
};

&mid_crit {
	temperature = <115000>;
};

&little_crit {
	temperature = <115000>;
};

/*
 * GSA's pin controller belongs to the secure world: a read of its registers
 * from Linux raises a synchronous external abort (its debugfs pin list
 * oopsed and once hung the phone). Nothing here uses its one bank (gps3).
 */
&pinctrl_gsactrl {
	status = "disabled";
};

/*
 * Wi-Fi: the BCM4389 on PCIe GEN4A_1 (Google's gs101-common-wlan.dtsi):
 * WL_REG_ON on gpp14-2. As on cheetah, its DMA buffers come from a
 * restricted pool below 4 GiB (2 address cells, 1 size cell on gs101).
 * Google's raven node runs the link without cache coherency.
 */
/ {
	wlan_pwr: regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "wlan-reg-on";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpp14 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;
	};

	reserved-memory {
		wifi_dma_pool: wifi-dma-pool {
			compatible = "restricted-dma-pool";
			size = <0x1000000>;
			alignment = <0x0 0x200000>;
			/* the chip's writes above 4 GiB are not seen (cheetah) */
			alloc-ranges = <0x0 0x80000000 0x80000000>;
		};
	};
};

&pcie_1_phy {
	status = "okay";
};

&pcie_1 {
	status = "okay";

	pcie@0,0 {
		compatible = "pciclass,0604";
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <0x01 0xff>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		vpcie3v3-supply = <&wlan_pwr>;

		wifi@0,0 {
			compatible = "pci14e4,4441";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			brcm,board-type = "google,gs101-raven";
			memory-region = <&wifi_dma_pool>;
		};
	};
};

/ {
	aliases {
		/* the modem's first boot stage: cpboot_spi_bus_num = 9 */
		spi9 = &spi_9;
	};
};

/*
 * Modem: Samsung S5123 on PCIe GEN4A_0 (HSI1), with its control lines from
 * stock's cpif node (board overlay 6). Raw levels, as Google's CPIF drives
 * them. The S5123 has no warm-reset lines. The link driver (pcie-gs201-cp)
 * keeps the PCIe channel; Google's CPIF (the cpif node below) takes the
 * lines and memory, so the modem child stays disabled.
 */
&pinctrl_hsi1 {
	status = "okay";
};

&pcie_0_phy {
	status = "okay";
};

&pcie_0 {
	status = "okay";
	/* the modem's MSI page: MSIs land here, as on stock */
	memory-region = <&cp_msi_mem>;
	/* stock's vreg1 and vreg2 (board overlay 6) */
	vdd085-supply = <&{/firmware/power-management/pmic-1/regulators/ldo16m}>;
	vdd18-supply = <&{/firmware/power-management/pmic-1/regulators/ldo18m}>;

	modem {
		compatible = "samsung,s5123-modem";
		status = "disabled";
		/* stock's cp_shmem order: IPC, MSI, PKTPROC, PKTPROC_UL */
		memory-region = <&cp_ipc_mem>, <&cp_msi_mem>,
				<&cp_pktproc_mem>, <&cp_pktproc_ul_mem>;
		ap2cp-pda-active-gpios = <&gph1 1 GPIO_ACTIVE_HIGH>;
		ap2cp-cp-pwr-on-gpios = <&gph1 0 GPIO_ACTIVE_HIGH>;
		ap2cp-nreset-gpios = <&gph1 3 GPIO_ACTIVE_HIGH>;
		ap2cp-wakeup-gpios = <&gph0 2 GPIO_ACTIVE_HIGH>;
		ap2cp-dump-noti-gpios = <&gph0 3 GPIO_ACTIVE_HIGH>;
		cp2ap-ps-hold-gpios = <&gpa9 5 GPIO_ACTIVE_HIGH>;
		cp2ap-wakeup-gpios = <&gpa8 4 GPIO_ACTIVE_HIGH>;
		cp2ap-phone-active-gpios = <&gpa8 5 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * The modem's first boot stage (the BOOT entry of modem.bin, under 128 KiB)
 * goes over USI9's SPI before its PCIe side comes up, as on stock (board
 * overlay 6: native chip select, 2.15 MHz).
 */
&usi9 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_9 {
	status = "okay";
	pinctrl-0 = <&spi9_bus &spi9_cs_func>;
	pinctrl-names = "default";
	num-cs = <1>;

	cpboot-spi@0 {
		compatible = "samsung,exynos-cp-spi";
		reg = <0>;
		spi-max-frequency = <2150000>;
	};
};

/*
 * The modem's shared memory, as stock's cp_shmem (board overlay 6): IPC,
 * the MSI page and the packet processor's downlink and uplink buffers. The
 * modem writes these by DMA once it runs, so Linux must never use them;
 * our kernel had them as System RAM. Reserved always, as on stock.
 */
/ {
	reserved-memory {
		cp_ipc_mem: cp-rmem@f0000000 {
			reg = <0x0 0xf0000000 0x800000>;
			no-map;
		};

		cp_msi_mem: cp-msi@f6200000 {
			reg = <0x0 0xf6200000 0x1000>;
			no-map;
		};

		cp_pktproc_mem: cp-rmem1@e8000000 {
			reg = <0x0 0xe8000000 0x1c00000>;
			no-map;
		};

		cp_pktproc_ul_mem: cp-rmem2@ee000000 {
			reg = <0x0 0xee000000 0x400000>;
			no-map;
		};
	};
};

/*
 * First light: no Type-C driver runs in the initramfs, so don't make the
 * controller wait for one. Plain USB 2 device mode on the USB 2 PHY, as on
 * cheetah, until the MAX77759 TCPC and the USB-C role switch are brought up.
 */
&usbdrd31_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usbdrd31_phy 0>;
	phy-names = "usb2-phy";
	/delete-property/ role-switch-default-mode;
	/*
	 * Keep usb-role-switch: in peripheral mode it registers nothing, but
	 * without it dwc3 looks for an extcon through the PHY's port and waits
	 * forever for the TCPC to provide one ("failed to get extcon").
	 */
};

/*
 * Without a TCPC driver nothing reports a cable orientation, and with
 * orientation-switch set the PHY never forces VBUS/B-valid, so dwc3 stays
 * "Disconnected". Without it the PHY forces both at init (exynos850-style
 * UTMI init), as it would on a board with no Type-C port controller.
 */
&usbdrd31_phy {
	/delete-property/ orientation-switch;
};

/*
 * NOT FOR MERGE: Google's CPIF (drivers/soc/google/cpif, imported for
 * bring-up) and its shared-memory description, as stock's cpif and
 * cp_shmem nodes (board overlay 6, factory image cp3a.261005.002.a1).
 * These bindings are Google's, not upstream's.
 */
/ {
	cp-shmem {
		compatible = "samsung,exynos-cp-shmem";
		cp_num = <0>;
		use_mem_map_on_cp = <0>;

		/* region,rmem: the modem node's memory-region entries */
		regions {
			ipc {
				region,name = "IPC";
				region,index = <3>;
				region,rmem = <0>;
				region,offset = <0>;
				region,size = <0x400000>;
				region,cached = <1>;
			};

			msi {
				region,name = "MSI";
				region,index = <11>;
				region,rmem = <1>;
				region,offset = <0>;
				region,size = <0x1000>;
				region,cached = <0>;
			};

			pktproc {
				region,name = "PKTPROC";
				region,index = <7>;
				region,rmem = <2>;
				region,offset = <0>;
				region,size = <0x1c00000>;
			};

			pktproc-ul {
				region,name = "PKTPROC_UL";
				region,index = <8>;
				region,rmem = <3>;
				region,offset = <0>;
				region,size = <0x400000>;
			};
		};
	};

	cpif {
		compatible = "samsung,exynos-cp";
		pci_ch_num = <0>;
		pci_db_addr = <0x40060000>;
		mif,name = "s5123";
		mif,cp_num = <0>;
		mif,modem_type = <1>;
		mif,protocol = <1>;
		mif,ipc_version = <0x32>;
		mif,link_type = <1>;
		mif,link_name = "PCIE";
		mif,link_attrs = <0xfc8>;
		cpboot_spi_bus_num = <9>;
		mif,interrupt_types = <1>;
		mif,capability_check = <1>;
		mif,int_ap2cp_msg = <0>;
		mif,int_ap2cp_wakeup = <1>;
		mif,int_ap2cp_status = <2>;
		mif,int_ap2cp_active = <3>;
		mif,int_ap2cp_lcd_status = <4>;
		mif,int_ap2cp_pcie_link_ack = <14>;
		mif,int_ap2cp_uart_noti = <15>;
		mif,irq_cp2ap_msg = <0>;
		mif,irq_cp2ap_status = <2>;
		mif,irq_cp2ap_active = <3>;
		mif,irq_cp2ap_wakelock = <8>;
		mif,irq_cp2ap_ratmode = <9>;
		legacy_fmt_head_tail_offset = <0x8>;
		legacy_fmt_buffer_offset = <0x1000>;
		legacy_fmt_txq_size = <0x1000>;
		legacy_fmt_rxq_size = <0x1000>;
		legacy_raw_head_tail_offset = <0x18>;
		legacy_raw_buffer_offset = <0x3000>;
		legacy_raw_txq_size = <0x1fd000>;
		legacy_raw_rxq_size = <0x200000>;
		legacy_raw_rx_buffer_cached = <0>;
		offset_srinfo_offset = <0x64>;
		offset_capability_offset = <0x70>;
		offset_boot_indicator = <0x90>;
		srinfo_offset = <0x300>;
		srinfo_size = <0x400>;
		capability_offset = <0xa0>;
		ap_capability_0 = <0>;
		ap_capability_1 = <0>;
		ap2cp_msg = <2 0x800>;
		cp2ap_msg = <2 0x804>;
		ap2cp_united_status = <2 0x808>;
		cp2ap_united_status = <2 0x80c>;
		ap2cp_kerneltime = <2 0x824>;
		ap2cp_handover_block_info = <2 0x82c>;
		sbi_lcd_status_mask = <0x1>;
		sbi_lcd_status_pos = <27>;
		sbi_crash_type_mask = <0xf>;
		sbi_crash_type_pos = <23>;
		sbi_uart_noti_mask = <0x1>;
		sbi_uart_noti_pos = <16>;
		sbi_ds_det_mask = <0x3>;
		sbi_ds_det_pos = <14>;
		sbi_pda_active_mask = <0x1>;
		sbi_pda_active_pos = <5>;
		sbi_ap_status_mask = <0xf>;
		sbi_ap_status_pos = <1>;
		sbi_cp_rat_mode_mask = <0x3f>;
		sbi_cp_rat_mode_pos = <26>;
		sbi_cp2ap_wakelock_mask = <0x1>;
		sbi_cp2ap_wakelock_pos = <6>;
		sbi_lte_active_mask = <0x1>;
		sbi_lte_active_pos = <5>;
		sbi_cp_status_mask = <0xf>;
		sbi_cp_status_pos = <1>;
		sbi_ap2cp_kerneltime_sec_mask = <0xfff>;
		sbi_ap2cp_kerneltime_sec_pos = <20>;
		sbi_ap2cp_kerneltime_usec_mask = <0xfffff>;
		sbi_ap2cp_kerneltime_usec_pos = <0>;
		pktproc_use_36bit_addr = <0>;


		/*
		 * The packet processor (mobile data), stock's values (board
		 * overlay 6), but uncached: with the cached mapping stock uses,
		 * the modem read stale uplink buffers here (MODEM-PLAN D2).
		 */
		pktproc_cp_base = <0x0 0x20000000>;

		pktproc_dl_support = <1>;
		pktproc_dl_version = <2>;
		pktproc_dl_info_rgn_offset = <0x0>;
		pktproc_dl_info_rgn_size = <0x1000>;
		pktproc_dl_desc_rgn_offset = <0x1000>;
		pktproc_dl_desc_rgn_size = <0xff000>;
		pktproc_dl_buff_rgn_offset = <0x100000>;
		pktproc_dl_buff_rgn_size = <0x1b00000>;
		pktproc_dl_info_rgn_cached = <0>;
		pktproc_dl_desc_rgn_cached = <0>;
		pktproc_dl_buff_rgn_cached = <0>;
		pktproc_dl_desc_mode = <1>;
		pktproc_dl_num_queue = <1>;
		pktproc_dl_use_exclusive_irq = <0>;
		pktproc_dl_use_hw_iocc = <1>;
		pktproc_dl_max_packet_size = <0x800>;
		pktproc_dl_use_dedicated_baaw = <0>;

		pktproc_ul_support = <1>;
		pktproc_ul_info_rgn_offset = <0x6000000>;
		pktproc_ul_info_rgn_size = <0x1000>;
		pktproc_ul_desc_rgn_offset = <0x6001000>;
		pktproc_ul_desc_rgn_size = <0x20000>;
		pktproc_ul_buff_rgn_offset = <0x6021000>;
		pktproc_ul_buff_rgn_size = <0x3df000>;
		pktproc_ul_padding_required = <1>;
		pktproc_ul_num_queue = <2>;
		pktproc_ul_max_packet_size = <0x800>;
		pktproc_ul_info_rgn_cached = <0>;
		pktproc_ul_desc_rgn_cached = <0>;
		pktproc_ul_buff_rgn_cached = <0>;
		pktproc_ul_use_hw_iocc = <1>;

		iodevs {
			io_device_0 {
				iod,name = "umts_ipc";
				iod,ch = <0xf5>;
				iod,format = <0>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0x2000>;
				iod,ch_count = <2>;
			};

			io_device_1 {
				iod,name = "umts_rfs0";
				iod,ch = <0x29>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_2 {
				iod,name = "umts_router";
				iod,ch = <0x15>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_3 {
				iod,name = "umts_dm0";
				iod,ch = <0x51>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0x4000>;
			};

			io_device_4 {
				iod,name = "umts_loopback";
				iod,ch = <0x52>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_5 {
				iod,name = "rmnet";
				iod,ch = <0xb5>;
				iod,format = <1>;
				iod,io_type = <2>;
				iod,link_type = <1>;
				iod,attrs = <0x2000>;
				iod,ch_count = <30>;
			};

			io_device_6 {
				iod,name = "umts_dummy";
				iod,ch = <0xd3>;
				iod,format = <1>;
				iod,io_type = <2>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_7 {
				iod,name = "multipdp";
				iod,ch = <0>;
				iod,format = <3>;
				iod,io_type = <3>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_8 {
				iod,name = "umts_boot0";
				iod,ch = <0xf1>;
				iod,format = <4>;
				iod,io_type = <0>;
				iod,link_type = <1>;
				iod,attrs = <0x200>;
			};

			io_device_9 {
				iod,name = "umts_rcs0";
				iod,ch = <0x5b>;
				iod,format = <0>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_10 {
				iod,name = "umts_rcs1";
				iod,ch = <0x5c>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_11 {
				iod,name = "umts_wfc0";
				iod,ch = <0x5d>;
				iod,format = <0>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_12 {
				iod,name = "umts_wfc1";
				iod,ch = <0x5e>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_13 {
				iod,name = "oem_ipc";
				iod,ch = <0x81>;
				iod,format = <0>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0x2000>;
				iod,ch_count = <8>;
			};

			io_device_14 {
				iod,name = "oem_test";
				iod,ch = <0x89>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};
		};
	};
};

